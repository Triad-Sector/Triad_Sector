# Triad: the drydock re-bake sweep's admin command. The description key is the one the Toolshed loc
# test reads, and has to match the command's own CommandDescription attribute.
command-description-drydockrebake = Starts the drydock re-bake sweep over every stored ship, unless one is already running.
drydock-rebake-command-started = Re-bake sweep started. Progress and the summary go to the server log.
drydock-rebake-command-running = A re-bake sweep is already running.
drydock-rebake-command-disabled = Not started: the drydock is off or read-only, triad.drydock.rebake_enabled is off, or triad.drydock.rebake_ships_per_minute is zero.
