# Triad: the drydock's round-end sweep. The warning goes to the owner of every drydock hull still
# out at each round-end warning, the call and each mark; the reason is what the owner reads on the
# impound card.
drydock-sweep-warning = Your ship {$ship} is still out. Store it within {$minutes} minutes or it will be impounded, and reclaiming it costs {$percent}% of its appraisal.
drydock-sweep-impound-reason = Still in the world at the end of round {$round}.
