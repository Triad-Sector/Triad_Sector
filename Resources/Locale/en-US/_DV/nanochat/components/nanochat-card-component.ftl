# Triad: TriTalk. Keys stay nanochat-* to match the ported Delta-V code, values are rebranded.

# Examine
nanochat-card-examine-no-number = The TriTalk card has not been assigned a number yet.
nanochat-card-examine-number = The TriTalk card displays #{$number}.

# Microwave interactions
nanochat-card-microwave-erased = The {$card} emits a soft beep as all its message history vanishes into the ether!
nanochat-card-microwave-scrambled = The {$card} crackles as its messages become scrambled!
