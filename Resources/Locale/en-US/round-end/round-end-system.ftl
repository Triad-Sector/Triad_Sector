## RoundEndSystem

# Triad: the round-end lore is a coronal mass ejection, not the Monolithic Emission.
# round-end-system-shuttle-called-announcement = Monolithic Emission Detected. ETA: {$time} {$units}. Enter cryogenic preservation for your safety.
round-end-system-shuttle-called-announcement = Coronal mass ejection detected. Impact ETA: {$time} {$units}. Return to port and enter cryogenic preservation for your safety.
round-end-system-shuttle-already-called-announcement = An emergency shuttle has already been sent.
# round-end-system-shuttle-auto-called-announcement = Monolithic Emission Detected. ETA: {$time} {$units}. Enter cryogenic preservation for your safety.
round-end-system-shuttle-auto-called-announcement = Coronal mass ejection detected. Impact ETA: {$time} {$units}. Return to port and enter cryogenic preservation for your safety.
# round-end-system-shuttle-recalled-announcement = The Monolithic Emission has receded.
round-end-system-shuttle-recalled-announcement = Updated solar forecast. The coronal mass ejection will miss the district. Normal operations may resume.
round-end-system-shuttle-sender-announcement = District
round-end-system-round-restart-eta-announcement = Restarting the round in {$time} {$units}...

eta-units-minutes = minutes
eta-units-seconds = seconds

# Triad: the round-end warnings RoundEndWarningSystem announces as the countdown runs down.
round-end-system-warning-15 = Coronal mass ejection inbound. Impact ETA: {$minutes} minutes. All vessels return to port.
round-end-system-warning-5 = Coronal mass ejection impact imminent. ETA: {$minutes} minutes. Secure your vessel and enter cryogenic preservation.
