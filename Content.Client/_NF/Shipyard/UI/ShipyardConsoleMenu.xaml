<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:ui="clr-namespace:Content.Client._NF.Shipyard.UI"
                      SetSize="1000 540"
                      MinSize="920 500">
    <PanelContainer VerticalExpand="True"
            HorizontalExpand="True"
            Margin="0 8 0 2">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BorderThickness="7"
                    BorderColor="#252525"
                    BackgroundColor="#3d474d"/>
        </PanelContainer.PanelOverride>
        <PanelContainer VerticalExpand="True"
                HorizontalExpand="True"
                Margin="4 4 4 4">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BorderThickness="2"
                        BorderColor="#333333"
                        BackgroundColor="#181818"/>
            </PanelContainer.PanelOverride>
            <!-- Triad: the purchase UI was the whole window; it is now the first tab, with drydock second -->
            <TabContainer Name="Tabs"
                    VerticalExpand="True"
                    HorizontalExpand="True">
                <BoxContainer Orientation="Vertical"
                        Margin="5 0 5 0">
                    <PanelContainer VerticalExpand="False"
                            HorizontalExpand="True"
                            Margin="0 8 0 2">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BorderThickness="2"
                                    BorderColor="#333333"
                                    BackgroundColor="#141414"/>
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical"
                                Margin="5 0 5 0">
                            <BoxContainer Orientation="Vertical">
                                <BoxContainer Orientation="Horizontal">
                                    <Label Text="{Loc 'bank-atm-menu-balance-label'}"
                                           StyleClasses="LabelKeyText"/>
                                    <Label Name="BalanceLabel"
                                           Text="{Loc 'shipyard-console-no-bank'}"/>
                                </BoxContainer>
                            </BoxContainer>
                            <BoxContainer Orientation="Vertical">
                                <BoxContainer Orientation="Horizontal">
                                    <Label Text="{Loc 'shipyard-console-appraisal-label'}"
                                           StyleClasses="LabelKeyText"/>
                                    <Label Name="ShipAppraisalLabel"
                                           Text="{Loc 'shipyard-console-no-deed'}"/>
                                </BoxContainer>
                            </BoxContainer>
                        </BoxContainer>
                    </PanelContainer>
                    <BoxContainer Orientation="Horizontal">
                        <PanelContainer VerticalExpand="True"
                                HorizontalExpand="True"
                                Margin="0 8 0 2">
                            <PanelContainer.PanelOverride>
                                <gfx:StyleBoxFlat BorderThickness="2"
                                        BorderColor="#333333"
                                        BackgroundColor="#141414"/>
                            </PanelContainer.PanelOverride>
                            <controls:StripeBack MinSize="48 48">
                                <LineEdit Name="SearchBar"
                                          PlaceHolder="{Loc 'cargo-console-menu-search-bar-placeholder'}"
                                          Margin="2 2 2 2"
                                          HorizontalExpand="True"/>
                            </controls:StripeBack>
                        </PanelContainer>
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <PanelContainer VerticalExpand="True"
                                HorizontalExpand="True"
                                Margin="0 8 0 2">
                            <PanelContainer.PanelOverride>
                                <gfx:StyleBoxFlat BorderThickness="3"
                                        BorderColor="#333333"
                                        BackgroundColor="#333333"/>
                            </PanelContainer.PanelOverride>
                            <PanelContainer Margin="1 1 1 1">
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BorderThickness="3"
                                            BorderColor="#636363"
                                            BackgroundColor="#141414"/>
                                </PanelContainer.PanelOverride>
                                <BoxContainer Orientation="Horizontal">
                                    <OptionButton Name="Categories"
                                                  Prefix="{Loc 'shipyard-console-menu-size-label'}"
                                                  StyleClasses="ButtonSquare"
                                                  Margin="2 2 2 2"
                                                  HorizontalExpand="True"/>
                                    <OptionButton Name="Classes"
                                                  Prefix="{Loc 'shipyard-console-menu-class-label'}"
                                                  StyleClasses="ButtonSquare"
                                                  Margin="2 2 2 2"
                                                  HorizontalExpand="True"/>
                                    <OptionButton Name="Engines"
                                                  Prefix="{Loc 'shipyard-console-menu-engine-label'}"
                                                  StyleClasses="ButtonSquare"
                                                  Margin="2 2 2 2"
                                                  HorizontalExpand="True"/>
                                </BoxContainer>
                            </PanelContainer>
                        </PanelContainer>
                    </BoxContainer>
                    <ScrollContainer HorizontalExpand="True"
                                     VerticalExpand="True"
                                     SizeFlagsStretchRatio="6">
                        <BoxContainer Name="Vessels"
                                      Orientation="Vertical"
                                      HorizontalExpand="True"
                                      VerticalExpand="True">
                            <!-- Vessels get added here by code -->
                        </BoxContainer>
                    </ScrollContainer>
                    <PanelContainer VerticalExpand="True"
                            HorizontalExpand="False"
                            Margin="0 8 0 2">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BorderThickness="3"
                                    BorderColor="#333333"
                                    BackgroundColor="#333333"/>
                        </PanelContainer.PanelOverride>
                        <PanelContainer Margin="1 1 1 1">
                            <PanelContainer.PanelOverride>
                                <gfx:StyleBoxFlat BorderThickness="3"
                                        BorderColor="#636363"
                                        BackgroundColor="#141414"/>
                            </PanelContainer.PanelOverride>
                            <!-- Triad: Columns 5 to 4, with the Unassign button removed. -->
                            <GridContainer Columns="4"
                                    HorizontalExpand="True"
                                    Margin="8 8 8 8">
                                <Button Name="TargetIdButton"
                                        Access="Public"
                                        StyleClasses="ButtonSquare"/>
                                <!-- Triad: the label comes from the state (Sell or Return Vessel); was Text="Sell" -->
                                <controls:ConfirmButton Name="SellShipButton"
                                                        Text="{Loc 'shipyard-console-sell-button'}"
                                                        ConfirmationText="{Loc 'shipyard-console-confirm-unassign'}"
                                                        StyleClasses="ButtonSquare"
                                                        Disabled="True"/>
                                <!-- Triad: removed. Unassign could strand a deed with no way back; the drydock tab's reissue moves deeds now.
                                <controls:ConfirmButton Name="UnassignDeedButton"
                                    Text="{Loc 'shipyard-console-unassign-deed'}"
                                    ConfirmationText="{Loc 'shipyard-console-confirm-unassign'}"
                                    StyleClasses="ButtonSquare ButtonCaution"
                                    Disabled="True" />
                                -->

                                <BoxContainer Orientation="Vertical">
                                    <Label Text="{Loc 'shipyard-console-deed-label'}"/>
                                    <Label Name="DeedTitle"
                                           Text=""/>
                                </BoxContainer>
                            </GridContainer>
                        </PanelContainer>
                    </PanelContainer>
                    <!-- Triad: removed. A hull is renamed from the drydock tab while it is stored, where the new name reaches hull and deed on the next retrieve.
                        <BoxContainer Orientation="Horizontal" Margin="0 2 0 2" Name="RenameContainer" Visible="False">
                            <LineEdit Name="RenameLineEdit"
                                    PlaceHolder="Name"
                                    MinWidth="140"
                                    Editable="False" />
                            <Button Name="RenameButton"
                                    Text="Rename"
                                    Disabled="True" />
                        </BoxContainer>
                        -->
                </BoxContainer>
                <!-- Triad: drydock tab. One row per berth; the inserted card shows its deed's ship
                with Store, or a transferred ship with Transfer deed. Berth verbs are in the details. -->
                <PanelContainer Name="DrydockTabRoot"
                        VerticalExpand="True"
                        HorizontalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BorderThickness="2"
                                BorderColor="#333333"
                                BackgroundColor="#181818"/>
                    </PanelContainer.PanelOverride>
                    <BoxContainer Name="DrydockTab"
                            Orientation="Vertical"
                            Margin="5 0 5 0">
                        <PanelContainer Name="DeedShipPanel"
                                Visible="False"
                                Margin="0 8 0 6">
                            <PanelContainer.PanelOverride>
                                <gfx:StyleBoxFlat BorderThickness="3" BorderColor="#333333" BackgroundColor="#333333"/>
                            </PanelContainer.PanelOverride>
                            <PanelContainer Margin="1 1 1 1">
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BorderThickness="3" BorderColor="#636363" BackgroundColor="#141414"/>
                                </PanelContainer.PanelOverride>
                                <BoxContainer Orientation="Horizontal"
                                        Margin="10 6"
                                        VerticalAlignment="Center">
                                    <RichTextLabel Name="DeedShipLabel"
                                            HorizontalExpand="True"
                                            VerticalAlignment="Center"/>
                                    <!-- Store sits on each free berth's row. This says why those buttons are greyed,
                                    and how far along a store is. -->
                                    <Label Name="StoreStatusLabel"
                                            Visible="False"
                                            Modulate="#d9a441"
                                            VerticalAlignment="Center"
                                            Margin="12 0 0 0"/>
                                    <!-- For a card with no deed while the operator has a ship out: moves that ship's
                                    deed onto the card, wherever the ship is. -->
                                    <Button Name="ReissueButton"
                                            Visible="False"
                                            StyleClasses="ButtonSquare"
                                            MinWidth="130"
                                            Text="{Loc 'shipyard-console-reissue-button'}"
                                            ToolTip="{Loc 'shipyard-console-reissue-tooltip'}"/>
                                </BoxContainer>
                            </PanelContainer>
                        </PanelContainer>

                        <!-- One card per ship of the operator's in the impound lot, built by PopulateImpounds. -->
                        <BoxContainer Name="Impounds"
                                Orientation="Vertical"/>

                        <!-- One alert per offer addressed to the operator, built by PopulateOffers. -->
                        <BoxContainer Name="Offers"
                                Orientation="Vertical"/>

                        <BoxContainer Orientation="Horizontal"
                                Margin="2 4 2 4"
                                VerticalAlignment="Center">
                            <Label Name="BerthSummaryLabel"
                                    HorizontalExpand="True"
                                    Modulate="#999999"/>
                            <ui:DrydockMenuButton Name="BuyBerthButton"
                                    StyleClasses="ButtonSquare"
                                    AlignRight="True"/>
                        </BoxContainer>
                        <!-- The list and its details, 8 to 4, laid out as SafetyDepositConsoleWindow lays out
                        its boxes: a row is picked on the left, and what can be done to it is on the right. -->
                        <BoxContainer Orientation="Horizontal"
                                HorizontalExpand="True"
                                VerticalExpand="True">
                            <ScrollContainer HorizontalExpand="True"
                                    VerticalExpand="True"
                                    HScrollEnabled="False"
                                    SizeFlagsStretchRatio="8">
                                <BoxContainer Name="Berths"
                                              Orientation="Vertical"
                                              HorizontalExpand="True"
                                              VerticalExpand="True">
                                    <!-- Rows are added by PopulateBerths -->
                                </BoxContainer>
                            </ScrollContainer>
                            <PanelContainer StyleClasses="LowDivider"
                                    VerticalExpand="True"
                                    SetWidth="2"
                                    Margin="6 0 6 0"/>
                            <PanelContainer HorizontalExpand="True"
                                    VerticalExpand="True"
                                    SizeFlagsStretchRatio="4"
                                    Margin="0 0 0 6">
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BorderThickness="3" BorderColor="#333333" BackgroundColor="#333333"/>
                                </PanelContainer.PanelOverride>
                                <PanelContainer Margin="1 1 1 1">
                                    <PanelContainer.PanelOverride>
                                        <gfx:StyleBoxFlat BorderThickness="3" BorderColor="#636363" BackgroundColor="#141414"/>
                                    </PanelContainer.PanelOverride>
                                    <Label Name="BerthDetailPlaceholder"
                                            Text="{Loc 'shipyard-console-detail-select'}"
                                            Modulate="#777777"
                                            Align="Center"
                                            VAlign="Center"
                                            HorizontalExpand="True"
                                            VerticalExpand="True"/>
                                    <!-- Fits at the default size; scrolls only when several cards stack above it. -->
                                    <ScrollContainer Name="BerthDetail"
                                            Visible="False"
                                            HScrollEnabled="False"
                                            HorizontalExpand="True"
                                            VerticalExpand="True">
                                        <BoxContainer Orientation="Vertical"
                                                HorizontalExpand="True"
                                                Margin="8">
                                            <RichTextLabel Name="BerthDetailTitle"
                                                    HorizontalExpand="True"/>
                                            <RichTextLabel Name="BerthDetailStatus"
                                                    HorizontalExpand="True"
                                                    Margin="0 0 0 6"/>
                                            <PanelContainer StyleClasses="LowDivider"
                                                    Margin="0 0 0 6"/>
                                            <BoxContainer Name="BerthDetailLines"
                                                    Orientation="Vertical"
                                                    HorizontalExpand="True"
                                                    Margin="0 0 0 8"/>
                                            <Button Name="RetrieveButton"
                                                    Text="{Loc 'shipyard-console-retrieve-button'}"
                                                    StyleClasses="ButtonSquare"
                                                    HorizontalExpand="True"
                                                    Margin="0 0 0 3"
                                                    Visible="False"/>
                                            <Button Name="CancelTransferButton"
                                                    Text="{Loc 'shipyard-console-transfer-cancel-button'}"
                                                    StyleClasses="ButtonSquare"
                                                    HorizontalExpand="True"
                                                    Margin="0 0 0 3"
                                                    Visible="False"/>
                                            <!-- Rename, Move and Transfer share a line, and the priced verbs get one each.
                                            Both built by PopulateBerthDetail. -->
                                            <GridContainer Name="BerthTools"
                                                    Columns="3"
                                                    HSeparationOverride="3"
                                                    HorizontalExpand="True"/>
                                            <BoxContainer Name="BerthActions"
                                                    Orientation="Vertical"
                                                    HorizontalExpand="True"/>
                                        </BoxContainer>
                                    </ScrollContainer>
                                </PanelContainer>
                            </PanelContainer>
                        </BoxContainer>
                    </BoxContainer>
                    <!-- Triad: this just shows whenever a criteria is met -->
                    <PanelContainer Name="LockoutPanel"
                            Visible="False"
                            MouseFilter="Stop"
                            VerticalExpand="True"
                            HorizontalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#140000"/>
                        </PanelContainer.PanelOverride>
                        <!-- The stripes tile through a styled panel set in code: TextureRect's Tile mode is not
                        implemented in the engine and draws the texture once in the corner. -->
                        <PanelContainer Name="LockoutStripes"
                                VerticalExpand="True"
                                HorizontalExpand="True"/>
                        <!-- The two big lines take their fonts in code; Nano has no 44 pt face to name here. -->
                        <BoxContainer Orientation="Vertical"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                            <Label Name="LockoutTitle"
                                    Text="{Loc 'shipyard-console-lockout-title'}"
                                    Modulate="#ff4a4a"
                                    Align="Center"/>
                            <Label Name="LockoutSubtitle"
                                    Text="{Loc 'shipyard-console-lockout-subtitle'}"
                                    Modulate="#ffb0b0"
                                    Align="Center"
                                    Margin="0 10 0 0"/>
                            <Label Name="LockoutBody"
                                    Text="{Loc 'shipyard-console-lockout-body'}"
                                    Modulate="#d08080"
                                    Align="Center"
                                    Margin="0 6 0 0"/>
                        </BoxContainer>
                    </PanelContainer>
                </PanelContainer>
            </TabContainer>
        </PanelContainer>
    </PanelContainer>
</controls:FancyWindow>
