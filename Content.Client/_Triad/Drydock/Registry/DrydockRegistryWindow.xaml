<!-- Triad: the drydock registry, built to the "Drydock Surfaces" canvas at game scale (artboards
     "Registry: every status" and "Registry: no matches", 2026-09-12). The admin panel's list column
     and nothing else: search, the status chips, the cards, then the match count and the page. No
     verbs, no timeline, no berths, no notes, no account names.

     Chips and cards are built in code into the named holders; this file is the frame. -->
<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      SetSize="760 610"
                      MinSize="700 500">
    <PanelContainer VerticalExpand="True" HorizontalExpand="True">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#1b1b1e"/>
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">

            <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True" Margin="4 6 4 4">
                <LineEdit Name="SearchInput" PlaceHolder="{Loc 'drydock-registry-search-placeholder'}" />
                <GridContainer Name="ChipGrid" Columns="5" HSeparationOverride="4" VSeparationOverride="4" Margin="0 4 0 0" />

                <ScrollContainer Name="ShipScroll" VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False" Margin="0 6 0 0">
                    <BoxContainer Name="ShipContainer" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>

                <!-- No matches: one bordered panel and one line, in the list's place. -->
                <PanelContainer Name="EmptyPanel" Visible="False" VerticalExpand="True" HorizontalExpand="True" Margin="0 6 0 0">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1b1b1e" BorderColor="#3a3a3e" BorderThickness="1"/>
                    </PanelContainer.PanelOverride>
                    <Label Text="{Loc 'drydock-registry-empty'}" Modulate="#8d8d8d"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                </PanelContainer>

                <BoxContainer Orientation="Horizontal" Margin="0 4 0 0" MinHeight="28" VerticalAlignment="Center">
                    <Label Name="CountLabel" Modulate="#8d8d8d" HorizontalExpand="True" VerticalAlignment="Center" />
                    <Button Name="PrevPageButton" Text="{Loc 'drydock-admin-prev'}" StyleClasses="ButtonSquare" VerticalAlignment="Center" />
                    <Label Name="PageLabel" Margin="6 0" VerticalAlignment="Center" />
                    <Button Name="NextPageButton" Text="{Loc 'drydock-admin-next'}" StyleClasses="ButtonSquare" VerticalAlignment="Center" />
                </BoxContainer>
            </BoxContainer>

            <!-- The shipyard console's own footer, because this is the same family of machine. -->
            <BoxContainer Orientation="Vertical">
                <PanelContainer StyleClasses="LowDivider" />
                <BoxContainer Orientation="Horizontal" Margin="10 5 5 4" VerticalAlignment="Bottom">
                    <Label Text="{Loc 'drydock-registry-flavor-left'}" StyleClasses="WindowFooterText" />
                    <Label Text="{Loc 'apc-menu-flavor-right'}" StyleClasses="WindowFooterText"
                           HorizontalAlignment="Right" HorizontalExpand="True" Margin="0 0 5 0" />
                    <TextureRect StyleClasses="NTLogoDark" Stretch="KeepAspectCentered"
                                 VerticalAlignment="Center" HorizontalAlignment="Right" SetSize="19 19"/>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:FancyWindow>
