<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:preview="clr-namespace:Content.Client._Triad.ShipPreview.UI"
               Title="{Loc 'triad-ship-preview-title'}"
               MinSize="420 340"
               SetSize="700 550">
    <BoxContainer Orientation="Vertical" Margin="4">
        <Label Name="VesselNameLabel" StyleClasses="LabelHeading" />
        <Label Name="ShipSizeLabel" StyleClasses="LabelSubText" Margin="0 0 0 4" />
        <preview:ShipPreviewView Name="ShipView"
                                 HorizontalExpand="True"
                                 VerticalExpand="True"
                                 MinSize="200 200" />
        <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
            <Button Name="ResetViewButton"
                    Text="{Loc 'triad-ship-preview-reset-view'}"
                    StyleClasses="ButtonSquare" />
            <Label Text="{Loc 'triad-ship-preview-hint'}"
                   StyleClasses="LabelSubText"
                   HorizontalExpand="True"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
