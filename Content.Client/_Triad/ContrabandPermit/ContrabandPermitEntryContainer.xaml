<BoxContainer
    HorizontalExpand="True"
    Margin="0,0,0,3"
    Orientation="Vertical"
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Button
        Access="Public"
        Name="FocusButton"
        StyleClasses="OpenLeft">
        <BoxContainer
            HorizontalExpand="True"
            Orientation="Horizontal"
            VerticalExpand="True">
            <!--  Owner sprite  -->
            <SpriteView
                Name="PermitOwnerSprite"
                Margin="6,2"
                Scale="2 2"/>

            <!--  Owner name  -->
            <Label
                HorizontalExpand="True"
                Margin="5,0"
                Name="PermitOwnerNameLabel" />

            <!--  Amount of permits  -->
            <Label
                HorizontalAlignment="Right"
                Margin="5,0"
                Name="PermitAmountLabel"
                Text="{Loc 'contraband-permit-console-window-permit-owner-entries-placeholder'}" />
        </BoxContainer>
    </Button>

    <!--  Panel that appears on selecting the file  -->
    <PanelContainer
        Access="Public"
        Margin="1,-1,1,0"
        Name="FocusContainer"
        ReservesSpace="False"
        Visible="False">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#25252a" />
        </PanelContainer.PanelOverride>
        <BoxContainer Margin="6,3" Orientation="Horizontal">
            <!--  Permit list  -->
            <BoxContainer
                Margin="0,6,0,6"
                Orientation="Vertical"
                MinSize="300 30">
                <Label HorizontalExpand="True" HorizontalAlignment="Center" Text="{Loc 'contraband-permit-console-window-permit-entries-list'}"/>
                <!--  Scroll container containing the permit selectors  -->
                <ScrollContainer HorizontalAlignment="Left"
                        Margin="4"
                        MinWidth="300"
                        MinHeight="30"
                        VerticalExpand="True">
                    <BoxContainer Orientation="Vertical"
                                  VerticalExpand="True"
                                  HorizontalExpand="True"
                                  MinSize="50 50"
                                  Name="PermitScrollContainer"
                                  Margin="4"/>
                </ScrollContainer>
            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider"
                            VerticalExpand="True"
                            Margin="6 0 0 0"
                            SetWidth="2"/>

            <!-- No item selected screen -->
            <BoxContainer Name="NoItemSelectedScreen"
                          VerticalExpand="True"
                          HorizontalExpand="True"
                          Orientation="Vertical"
                          Visible="True"
                          ReservesSpace="False">

                <controls:StripeBack VerticalExpand="True"
                                     HorizontalExpand="True"
                                     Margin="0 0 0 5">
                    <PanelContainer VerticalExpand="True"
                                    HorizontalExpand="True">
                        <BoxContainer VerticalExpand="True"
                                      HorizontalExpand="True"
                                      Orientation="Vertical">
                            <Control VerticalExpand="True"/>
                            <TextureRect VerticalAlignment="Center"
                                         HorizontalAlignment="Center"
                                         SetSize="64 64"
                                         Stretch="KeepAspectCentered"
                                         TexturePath="/Textures/Interface/VerbIcons/information.192dpi.png">
                            </TextureRect>
                            <Label Text="{Loc 'contraband-permit-console-window-permit-entries-select-entry'}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0 5 0 0"/>
                            <Control VerticalExpand="True"/>
                        </BoxContainer>
                    </PanelContainer>
                </controls:StripeBack>
            </BoxContainer>

            <!-- Viewing the permit itself  -->
            <BoxContainer
                HorizontalExpand="True"
                Margin="6,0,0,0"
                Name="PermitViewContainer"
                Orientation="Vertical"
                VerticalExpand="True"
                Visible="False">

                <!-- Selected item info  -->
                <BoxContainer Margin="0,1" Orientation="Vertical">
                    <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left">
                        <Label
                            HorizontalExpand="True"
                            Text="Selected Item:" />
                        <Label
                            HorizontalExpand="True"
                            Margin="15,0"
                            Name="SelectedItemLabel"
                            Text="Example" />
                    </BoxContainer>
                </BoxContainer>

                <!-- Date granted info  -->
                <BoxContainer Margin="0,1" Orientation="Vertical">
                    <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left">
                        <Label
                            HorizontalExpand="True"
                            Text="Date Granted:" />
                        <Label
                            HorizontalExpand="True"
                            Margin="15,0"
                            Name="DateGrantedLabel"
                            Text="Example" />
                    </BoxContainer>
                </BoxContainer>

                <!-- Owner name -->
                <BoxContainer Margin="0,1" Orientation="Vertical">
                    <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left">
                        <Label
                            HorizontalExpand="True"
                            Text="Owner Name:" />
                        <Label
                            HorizontalExpand="True"
                            Margin="15,0"
                            Name="OwnerNameLabel"
                            Text="Example" />
                    </BoxContainer>
                </BoxContainer>

                <!-- Owner species -->
                <BoxContainer Margin="0,1" Orientation="Vertical">
                    <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left">
                        <Label
                            HorizontalExpand="True"
                            Text="Owner Species:" />
                        <Label
                            HorizontalExpand="True"
                            Margin="15,0"
                            Name="OwnerSpeciesLabel"
                            Text="Example" />
                    </BoxContainer>
                </BoxContainer>

                <!-- Owner gender -->
                <BoxContainer Margin="0,1" Orientation="Vertical">
                    <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left">
                        <Label
                            HorizontalExpand="True"
                            Text="Owner Gender:" />
                        <Label
                            HorizontalExpand="True"
                            Margin="15,0"
                            Name="OwnerGenderLabel"
                            Text="Example" />
                    </BoxContainer>
                </BoxContainer>

                <!-- Owner age -->
                <BoxContainer Margin="0,1" Orientation="Vertical">
                    <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left">
                        <Label
                            HorizontalExpand="True"
                            Text="Owner Age:" />
                        <Label
                            HorizontalExpand="True"
                            Margin="15,0"
                            Name="OwnerAgeLabel"
                            Text="Example" />
                    </BoxContainer>
                </BoxContainer>

                <!-- Owner eye color -->
                <BoxContainer Margin="0,1" Orientation="Vertical">
                    <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left">
                        <Label
                            HorizontalExpand="True"
                            Text="Owner Eye Color:" />
                        <Label
                            HorizontalExpand="True"
                            Margin="15,0"
                            Name="OwnerEyeColorLabel"
                            Text="Example" />
                    </BoxContainer>
                </BoxContainer>

            </BoxContainer>
        </BoxContainer>
    </PanelContainer>

</BoxContainer>
